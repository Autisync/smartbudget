# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Ensure dSYM files are generated for all Pod targets (including objective_c.framework)
      # so Xcode archive includes the required DWARF debug symbols.
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
    end
  end

  # sqlcipher_flutter_libs + firebase_messaging fix (root cause of the
  # "SQLCipher is not active" crash — see database_cipher.dart's guard).
  # FirebaseMessaging's podspec declares `s.library = 'sqlite3'`, which links
  # Apple's system libsqlite3 alongside our SQLCipher.framework. Both export
  # identical C symbol names (sqlite3_open, sqlite3_key, ...), and since
  # CocoaPods aggregates pod linker flags alphabetically, FirebaseMessaging's
  # `-lsqlite3` lands before `-framework SQLCipher` in Pods-Runner.xcconfig.
  # Dart's DynamicLibrary.process() then resolves those symbols against the
  # unencrypted system library instead of SQLCipher, so `PRAGMA cipher_version`
  # comes back empty. See sqlcipher_flutter_libs' own README
  # ("Incompatibilities with sqlite3 on iOS and macOS") and
  # https://github.com/simolus3/drift/issues/1810#issuecomment-1119426006.
  #
  # Mutating the Xcodeproj Ruby objects above does NOT fix this: CocoaPods
  # writes each pod's Target Support Files/*.xcconfig (and the aggregated
  # Pods-Runner.*.xcconfig) to disk before post_install runs, and nothing
  # re-syncs them from the in-memory PBXNativeTarget afterward. Patch the
  # already-written xcconfig files directly instead.
  xcconfig_glob = File.join(__dir__, 'Pods', 'Target Support Files', '**', '*.xcconfig')
  patched = []
  Dir.glob(xcconfig_glob).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    next unless content.include?('sqlite3')

    updated = content.gsub(/\s*-l"?sqlite3"?/, '')
    if updated != content
      File.write(xcconfig_path, updated)
      patched << xcconfig_path
    end
  end
  unless patched.empty?
    puts "[Podfile] Stripped -lsqlite3 from #{patched.length} xcconfig file(s) " \
         "so SQLCipher's symbols aren't shadowed by the system library."
  end
end
