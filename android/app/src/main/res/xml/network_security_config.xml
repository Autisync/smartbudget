<?xml version="1.0" encoding="utf-8"?>
<!--
  M-5 FIX: Explicit network security config.
  - Blocks all cleartext HTTP traffic in production.
  - Allows cleartext only for local emulator / simulator addresses used in debug.
  - Trust only the system CA store (no user-installed CAs accepted).
-->
<network-security-config>
    <!-- Default: HTTPS only, system CAs only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Dev-only exception: allow HTTP to emulator / simulator loopback. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
