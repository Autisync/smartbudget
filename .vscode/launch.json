{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Current Device",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=AUTH_API_BASE_URL=http://127.0.0.1:8000"
      ]
    },
    {
      "name": "Flutter: Android Emulator",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=AUTH_API_BASE_URL=http://10.0.2.2:8000"
      ]
    },
    {
      "name": "Flutter: Web Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=AUTH_API_BASE_URL=http://127.0.0.1:8000"
      ]
    },
    {
      "name": "Backend: FastAPI",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true
    }
  ],
  "compounds": [
    {
      "name": "Backend + Flutter Web",
      "configurations": [
        "Backend: FastAPI",
        "Flutter: Web Chrome"
      ],
      "stopAll": true
    }
  ]
}
