APP_NAME=smartbudget-auth
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://smaartspend.com

POSTGRES_DB=smartbudget
POSTGRES_USER=smartbudget
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://smartbudget:change-me@postgres:5432/smartbudget
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Per-process connection pool bounds — see backend/PERFORMANCE_NOTES.md.
# Total backend connections at peak = UVICORN_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
UVICORN_WORKERS=2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
VERIFY_EMAIL_TTL_SECONDS=86400

LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
# IP-independent per-account cap (see M-1) — catches distributed brute force
# that rotates source IPs to bypass the per-(IP, email) bucket above.
LOGIN_RATE_LIMIT_PER_ACCOUNT_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_PER_ACCOUNT_MAX_ATTEMPTS=20

RESET_PASSWORD_DEEP_LINK_BASE=https://api.smaartspend.com/r/reset-password
VERIFY_EMAIL_DEEP_LINK_BASE=https://api.smaartspend.com/r/verify-email
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_AUDIENCES=

# Email delivery — MUST be enabled in production or no mail is sent (the app
# only logs "SMTP disabled" and returns). Use a verified sender domain with
# SPF/DKIM/DMARC configured, or mail will be silently dropped/spam-filed.
SMTP_ENABLED=true
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=no-reply@smaartspend.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@smaartspend.com
SMTP_FROM_NAME=SmartBudget

# Error monitoring — empty DSN is a safe no-op (nothing initialized, nothing
# sent). Mirrors the Flutter app's own ErrorMonitor pattern.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional — restricts /health/ready to callers sending this exact value in
# an X-Health-Check-Token header (e.g. your uptime monitor). Empty = anyone
# can call it (fine for local/dev; consider setting this in production).
HEALTH_CHECK_TOKEN=
