APP_NAME=smartbudget-auth
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/smartbudget
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
VERIFY_EMAIL_TTL_SECONDS=86400

LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

RESET_PASSWORD_DEEP_LINK_BASE=smartbudget://reset-password
VERIFY_EMAIL_DEEP_LINK_BASE=smartbudget://verify-email

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SmartBudget
